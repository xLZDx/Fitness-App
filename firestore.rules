rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Per-user data: every subcollection under /users/{uid}/ is the user's
    // own to read and write — except the collections carved out below, each
    // for its own reason. The Cloud Functions backend (running with the
    // Admin SDK, no auth context) writes to /users/{uid}/subscription/main
    // via the Stripe webhook. Clients can read their record so the UI shows
    // tier + status, but they can never mutate it.
    //
    // G-D / F005, F006, N03: `usage`, `receipts` and `profile` joined this
    // list. All three used to fall through to this wildcard's blanket
    // client-write grant, which meant a client could quietly undo work three
    // separate server-side mechanisms do on its behalf — see each one's own
    // block below for what it actually protects. `usage` and `receipts` are
    // excluded from read too: no client reads either directly (each is
    // returned inline by the callable that writes it), and the more specific
    // blocks below saying `if false` do nothing against a wildcard that
    // still grants the same request — Firestore allows a request if ANY
    // matching rule permits it, so a blanket read grant here would have kept
    // overriding a stricter one there.
    // P1.G1 T2 (SPTR Equipment Recognition v4.4): `recognised_models`,
    // `equipment_identity_sessions` and `equipment_identity_telemetry` join
    // the carve-out list for the same reason `usage`/`receipts`/`profile`
    // did — each is server-authored and the wildcard's blanket client-write
    // grant would let a client forge or erase server-computed identity
    // state. `equipment_identity_sessions`/`equipment_identity_telemetry`
    // are excluded from read too (no client reads either directly, same
    // rationale as `usage`/`receipts`); `recognised_models` keeps its read
    // grant here removed as well and re-added explicitly below so its
    // read/write pair lives in one self-contained block a reviewer (or a
    // mutation test) can point at without cross-referencing this wildcard.
    match /users/{uid}/{coll}/{document=**} {
      allow read: if request.auth != null
                  && request.auth.uid == uid
                  && coll != 'usage'
                  && coll != 'receipts'
                  && coll != 'recognised_models'
                  && coll != 'equipment_identity_sessions'
                  && coll != 'equipment_identity_telemetry';
      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && coll != 'subscription'
                   && coll != 'usage'
                   && coll != 'receipts'
                   && coll != 'profile'
                   && coll != 'recognised_models'
                   && coll != 'equipment_identity_sessions'
                   && coll != 'equipment_identity_telemetry';
    }

    // F005: `abuse_guard.ts`'s daily quota lives at
    // `users/{uid}/usage/{yyyy-mm-dd}`, read-then-compare-then-write inside a
    // transaction so two concurrent calls cannot both slip under the limit.
    // The wildcard rule above used to let the same client that transaction
    // limits simply overwrite or delete its own counter directly — the
    // server-side atomicity bought nothing if the number it protected was
    // still client-writable. No client reads this collection today (the
    // callable returns whatever it needs in its own response), so closed
    // outright rather than opened read-only for a caller that does not exist.
    match /users/{uid}/usage/{day} {
      allow read, write: if false;
    }

    // F006: `generateAnnualReceipt` writes to `users/{uid}/receipts/{year}`
    // from figures it pulled from Stripe directly — no client-supplied
    // field reaches the document. The comment on that function is explicit
    // about why this collection cannot be client-writable: it is "the one
    // document a user might hand to a tax authority," and a client that can
    // edit or delete it after the fact makes it worthless as a record of
    // what was actually charged. No client reads this collection either
    // (the callable's own response is what the UI renders).
    match /users/{uid}/receipts/{year} {
      allow read, write: if false;
    }

    // N03: `DeviceHealthProfileRepository` (mobile/lib/features/profile/data/
    // device_health_profile_repository.dart) strips every free-text health
    // field out of a profile before `FirestoreProfileRepository` ever sees
    // it — that split is what backs the privacy policy's "health answers
    // stay on your phone" claim. It was enforced by client code alone:
    // nothing here independently rejected a write that skipped the strip,
    // whether from a modified client or a future regression in the decorator
    // itself. This mirrors the shape `stripSensitive()` produces
    // (sensitive_profile.dart) — every free-text/list health field empty,
    // and lifestyle.smoking/alcohol null — and rejects anything else, so a
    // write that still carries a real condition, medication or injury is
    // refused at the one layer a client cannot route around.
    // `screening` and `flags` are read through get() with a default, unlike the
    // eight fields above. Two different reasons, and both matter:
    //
    //   - tolerance: an older client that predates a field writes a `health`
    //     map without the key. A bare `h.flags` on a missing key errors, and an
    //     erroring rule denies -- which would reject a legitimate write from an
    //     installed build rather than the attack this is here to stop.
    //   - the defect this replaces: the function inspected eight fields and the
    //     model had grown to ten. `HealthHistory.toJson` serialises the PAR-Q+
    //     answers and the normalised flags INSIDE this same map, so a client
    //     that emptied the eight while carrying real screening answers and
    //     restrictions passed the check that exists to make the strip
    //     independent of the client. The most structured health data the model
    //     holds was the part the backstop did not look at.
    //
    // Same shape of miss as F014's (N-01): a field added to the model and its
    // serialiser, not added to the thing guarding it.
    function healthIsStripped(h) {
      return h.conditions.size() == 0
          && h.allergies.size() == 0
          && h.medications.size() == 0
          && h.injuries.size() == 0
          && h.physicalLimitations.size() == 0
          && h.recentSurgeries.size() == 0
          && h.bloodPressure == null
          && h.otherConcerns == null
          && h.get('screening', {}).size() == 0
          && flagsAreStripped(h.get('flags', {}));
    }
    // Every answer HealthFlags can carry. Listed one by one rather than by
    // size(), because a stripped block legitimately still has the KEYS -- what
    // it must not have is a value in any of them.
    function flagsAreStripped(f) {
      return f.get('restrictions', []).size() == 0
          && f.get('bloodPressure', null) == null
          && f.get('surgery', null) == null
          && f.get('clinicianAdvice', null) == null
          && f.get('professionalGuidance', null) == null;
    }
    match /users/{uid}/profile/{docId} {
      allow read: if request.auth != null && request.auth.uid == uid;
      // Tolerant of a write that omits `health`/`lifestyle` altogether
      // (a partial field update, or a document shape this rule has not seen
      // yet) — it only refuses a write that INCLUDES a health block and that
      // block is not the stripped shape. What it must never accept is a
      // present `health` carrying real content.
      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && (!('health' in request.resource.data)
                       || healthIsStripped(request.resource.data.health))
                   && (!('lifestyle' in request.resource.data)
                       || (!('smoking' in request.resource.data.lifestyle)
                           || request.resource.data.lifestyle.smoking == null))
                   && (!('lifestyle' in request.resource.data)
                       || (!('alcohol' in request.resource.data.lifestyle)
                           || request.resource.data.lifestyle.alcohol == null));
    }

    // Equipment + exercise catalogs are read-only for clients.
    // Server-side admin scripts write these via the Admin SDK.
    match /equipment/{anyId} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    match /exercises/{anyId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Gym registry — clients can read so the QR scanner can resolve
    // gymId → display name + maintenance metadata, but only the
    // server (Admin SDK) writes via the gym-onboarding tooling.
    match /gyms/{gymId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Public donor wall — one document per donor who opted in.
    //
    // This block was missing, which meant the collection was default-denied
    // and `CloudDonorWallRepository` got permission-denied on every read for
    // every user. Its own comment says "public read, no client write"; the
    // read half was never granted. Broken at one user, not at a thousand.
    //
    // Read is open rather than `request.auth != null`: `/donors` is a public
    // route in the app router, reachable signed-out, and a wall of people who
    // chose to be listed publicly is the one collection here with nothing to
    // protect. Writes stay server-only — `optInDonorWall` verifies an active
    // subscription before adding anyone, and a client that could write here
    // could list itself as a donor without paying.
    //
    // Worth knowing when this goes live: it is the only shared-collection
    // listener in the app, so every opt-in fans out to every attached client.
    // The client keeps its `.limit(500)` for that reason.
    match /donor_wall/{donorId} {
      allow read: if true;
      allow write: if false;
    }

    // Equipment-failure reports (TX.7). Same server-only pattern as
    // subscriptions: the `reportEquipment` Cloud Function is the only
    // writer, and clients have no read access (reports surface to gym
    // staff via webhook + admin console, not the user's own app).
    match /equipment_reports/{anyId} {
      allow read: if false;
      allow write: if false;
    }

    // B6 session diagnostics. Written by DEBUG builds only, and read by
    // nobody through this API.
    //
    // Create-only for a signed-in user, and only for a document that stamps
    // its own uid. Not `allow write`, which would also grant update and
    // delete: a session log that a client can edit after the fact is not
    // evidence, it is a note. Read is closed outright -- these are inspected
    // in the Firebase console, and no client has any business reading another
    // person's session, or its own back.
    //
    // The log is redacted on the way in (core/diagnostics/debug_telemetry.dart)
    // and the collection only ever receives debug builds, but neither of those
    // is a rule. This is the rule.
    // P1a adds shape and size validation. Before it, this was the only
    // collection any signed-in client could write to in a shared namespace,
    // with no constraint but the uid stamp -- so a caller could create
    // unlimited documents of arbitrary shape, each up to Firestore's 1 MB
    // ceiling, under keys nothing reads. That is a storage bill with a uid
    // attached, and it is the same collection A3's export had to cap its
    // reads over for exactly this reason.
    //
    // The allowlist mirrors what `debug_telemetry.dart:175-179` and
    // `debug_telemetry_sink.dart:36-40` actually send, and the 500-event
    // ceiling is the writer's own ring-buffer capacity
    // (`debug_telemetry.dart:141`) rather than a number invented here -- so a
    // legitimate client cannot be refused, and a client sending more than its
    // own buffer can hold is not a legitimate client.
    //
    // This bounds SHAPE, not bytes: rules cannot measure document size, so a
    // 1 MB string inside `identity` still passes. What it removes is the
    // ability to store arbitrary keys and unbounded arrays, which is the part
    // that made this an open-ended dump.
    match /debug_sessions/{sessionId} {
      allow read: if false;
      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.keys().hasOnly(
                         ['identity', 'droppedCount', 'events',
                          'uid', 'receivedAt'])
                    && request.resource.data.keys().hasAll(['uid', 'events'])
                    && request.resource.data.events is list
                    && request.resource.data.events.size() <= 500;
      allow update, delete: if false;
    }

    // Coach marketplace bookings. This block grants nothing, and that is the
    // point of writing it down: the collection was previously absent from
    // this file entirely, so it was default-denied by accident of omission
    // rather than by decision. A reader could not tell the two apart, and the
    // next person to add a client-side booking query would have had no way to
    // know the denial was deliberate.
    //
    // `bookCoachSession` and `sweepSharedRecords` reach it with the Admin SDK,
    // which bypasses rules; `exportAccountData` reads a user's own bookings
    // the same way and redacts the counterparty. A client must never read
    // these directly: a booking names BOTH parties and carries a
    // payment-intent id (`index.ts:1154-1164`).
    match /coach_bookings/{bookingId} {
      allow read, write: if false;
    }

    // P1.G1 T2/T4 (SPTR Equipment Recognition v4.4, core/design/
    // sptr_equipment_recognition_v4_1/SPTR_EQUIPMENT_RECOGNITION_V4_4_GATE_
    // CONTRACTS_AND_AC_DOD_2026-08-22.md). A user's resolved exact-model
    // recognitions — server-written only (`functions-equipment-identity`'s
    // Admin SDK write path, once one exists), never client-authored. Owner
    // can read their own history; nobody can create/update/delete it from a
    // client, which is also how T4's authority-field immutability holds at
    // this layer: there is no client mutation surface at all, so a
    // `RecognitionAuthorityTuple` embedded in a resolved record can never be
    // altered post-write by anything but the server that wrote it.
    match /users/{uid}/recognised_models/{modelId} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // In-flight identity resolution session state (P2.G3 introduces the
    // runtime that actually writes these; the collection is carved out of
    // client reach here, ahead of that gate, so no client build can ever
    // have depended on writing or reading it directly). Entirely
    // server-internal — no client read, no client write.
    match /users/{uid}/equipment_identity_sessions/{sessionId} {
      allow read, write: if false;
    }

    // Recognition telemetry (latency, outcome counts, model/version tags
    // used for shadow evaluation in P6). Written by the server pipeline
    // only; a client that could edit or delete its own telemetry would make
    // it worthless as an evaluation signal.
    match /users/{uid}/equipment_identity_telemetry/{docId} {
      allow read, write: if false;
    }

    // P1.G1 T2: top-level canonical-catalog authority collections. All
    // server/admin-only for the whole of P1 — no P1 app screen or Flutter
    // provider reads this catalog (see P1.G6 §11.14), so client access is
    // closed outright rather than opened read-only for a caller that does
    // not exist yet. `equipment_catalog_active/current` stays server-only
    // too until a real P2 client requirement earns it a narrower read grant
    // — see P1.G1 evidence doc for why that is deliberate, not an oversight.
    // Versioned entity docs use a `{catalogVersion}--{id}` composite docId
    // (see P1.G1 §5.15), so a single `{docId}` wildcard per collection
    // covers every version without a subcollection.
    match /equipment_brands/{docId} {
      allow read, write: if false;
    }
    match /equipment_product_lines/{docId} {
      allow read, write: if false;
    }
    match /equipment_models/{docId} {
      allow read, write: if false;
    }
    match /equipment_model_setup_specs/{docId} {
      allow read, write: if false;
    }
    match /equipment_external_mappings/{docId} {
      allow read, write: if false;
    }
    match /equipment_sources/{sourceId} {
      allow read, write: if false;
    }
    match /equipment_assets/{docId} {
      allow read, write: if false;
    }
    match /equipment_catalog_publish_jobs/{jobId} {
      allow read, write: if false;
    }
    match /equipment_catalog_versions/{catalogVersion} {
      allow read, write: if false;
    }
    match /equipment_catalog_active/{docId} {
      allow read, write: if false;
    }
  }
}
