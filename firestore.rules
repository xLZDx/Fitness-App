rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Per-user data: every subcollection under /users/{uid}/ is the user's
    // own to read and write — except `subscription`, which is server-only.
    // The Cloud Functions backend (running with the Admin SDK, no auth
    // context) writes to /users/{uid}/subscription/main via the Stripe
    // webhook. Clients can read their record so the UI shows tier + status,
    // but they can never mutate it.
    match /users/{uid}/{coll}/{document=**} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && coll != 'subscription';
    }

    // Equipment + exercise catalogs are read-only for clients.
    // Server-side admin scripts write these via the Admin SDK.
    match /equipment/{anyId} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    match /exercises/{anyId} {
      allow read: if request.auth != null;
      allow write: if false;
    }
  }
}
