rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Per-user data: every subcollection under /users/{uid}/ is the user's
    // own to read and write — except the collections carved out below, each
    // for its own reason. The Cloud Functions backend (running with the
    // Admin SDK, no auth context) writes to /users/{uid}/subscription/main
    // via the Stripe webhook. Clients can read their record so the UI shows
    // tier + status, but they can never mutate it.
    //
    // G-D / F005, F006, N03: `usage`, `receipts` and `profile` joined this
    // list. All three used to fall through to this wildcard's blanket
    // client-write grant, which meant a client could quietly undo work three
    // separate server-side mechanisms do on its behalf — see each one's own
    // block below for what it actually protects. `usage` and `receipts` are
    // excluded from read too: no client reads either directly (each is
    // returned inline by the callable that writes it), and the more specific
    // blocks below saying `if false` do nothing against a wildcard that
    // still grants the same request — Firestore allows a request if ANY
    // matching rule permits it, so a blanket read grant here would have kept
    // overriding a stricter one there.
    // P1.G1 T2 (SPTR Equipment Recognition v4.4): `recognised_models`,
    // `equipment_identity_sessions` and `equipment_identity_telemetry` join
    // the carve-out list for the same reason `usage`/`receipts`/`profile`
    // did — each is server-authored and the wildcard's blanket client-write
    // grant would let a client forge or erase server-computed identity
    // state. `equipment_identity_sessions`/`equipment_identity_telemetry`
    // are excluded from read too (no client reads either directly, same
    // rationale as `usage`/`receipts`); `recognised_models` keeps its read
    // grant here removed as well and re-added explicitly below so its
    // read/write pair lives in one self-contained block a reviewer (or a
    // mutation test) can point at without cross-referencing this wildcard.
    //
    // Body Scan + Nutrition Coach (design s6.1, D-25): `body_scans`,
    // `body_scan_settings`, `weight_entries`, `nutrition_plan`,
    // `nutrition_plan_reviews`, `food_entries` and `saved_foods` join the
    // carve-out list in BOTH the read and the write condition below. Each has
    // its own explicit block further down that re-grants exactly what is
    // intended and shape-checks it; without the exclusion those blocks would
    // be dead, because this wildcard would still allow the very same request
    // (Firestore allows a request if ANY matching rule permits it). `body_scans`
    // in particular is server-authored: a client that kept the wildcard's
    // blanket write could forge a provider estimate or erase the tombstone the
    // purge job relies on.
    //
    // Unified activity (S02 design s4, GPS-PRIV-058/071): `activities`,
    // `activity_streams`, `activity_settings` and `activity_tombstones` join
    // the carve-out list in BOTH the read and the write condition below. This
    // is a permanent floor: each has its own block near the end of this file,
    // and without the exclusion the wildcard would still allow the very same
    // request (Firestore allows a request if ANY matching rule permits it), so
    // a client could write a geometry key into `activities` or forge a stream
    // index row, a consent document or a tombstone. Never remove one of the
    // four names from either condition.
    //
    // MVP1.G3 Step 8/9: `isCanaryToken()` excludes the synthetic canary
    // identity (core/G3_STEP8_RUNTIME_PREREQUISITES.md Sec 3/9) from this
    // wildcard explicitly, regardless of what uid it is minted for. Without
    // this, a request authenticated as the canary's own uid would get the
    // SAME blanket grant any real user gets over `/users/{that uid}/...` --
    // relying on "no real data happens to live there in practice" instead of
    // a structural guarantee, exactly the gap GPT-PM's review of the canary
    // design required closing before Step 9 builds against it. The canary's
    // only grant is the dedicated `/_canary/{canaryUid}` block below.
    function isCanaryToken() {
      return request.auth != null
          && request.auth.token.get('canary', false) == true;
    }

    // CR-05. Firestore allows a request if ANY matching rule permits it, so the
    // wildcard's `!isCanaryToken()` above does nothing against a separate,
    // more specific grant for the same path that omits it. Every non-public
    // grant for an authenticated caller therefore goes through this one
    // predicate instead of a bare `request.auth != null`, which is what keeps
    // "the canary's ENTIRE grant is `_canary/{its uid}`" true. Public
    // surfaces (`donor_wall`, `allow read: if true`) are deliberately not
    // routed through it.
    function isOrdinaryUser() {
      return request.auth != null && !isCanaryToken();
    }
    match /users/{uid}/{coll}/{document=**} {
      allow read: if request.auth != null
                  && request.auth.uid == uid
                  && !isCanaryToken()
                  && coll != 'usage'
                  && coll != 'receipts'
                  && coll != 'profile'
                  && coll != 'recognised_models'
                  && coll != 'equipment_identity_sessions'
                  && coll != 'equipment_identity_latest_session'
                  && coll != 'equipment_identity_telemetry'
                  && coll != 'body_scans'
                  && coll != 'body_scan_settings'
                  && coll != 'weight_entries'
                  && coll != 'nutrition_plan'
                  && coll != 'nutrition_plan_reviews'
                  && coll != 'food_entries'
                  && coll != 'saved_foods'
                  && coll != 'activities'
                  && coll != 'activity_streams'
                  && coll != 'activity_settings'
                  && coll != 'activity_tombstones';
      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && !isCanaryToken()
                   && coll != 'subscription'
                   && coll != 'usage'
                   && coll != 'receipts'
                   && coll != 'profile'
                   && coll != 'recognised_models'
                   && coll != 'equipment_identity_sessions'
                   && coll != 'equipment_identity_latest_session'
                   && coll != 'equipment_identity_telemetry'
                   && coll != 'body_scans'
                   && coll != 'body_scan_settings'
                   && coll != 'weight_entries'
                   && coll != 'nutrition_plan'
                   && coll != 'nutrition_plan_reviews'
                   && coll != 'food_entries'
                   && coll != 'saved_foods'
                   && coll != 'activities'
                   && coll != 'activity_streams'
                   && coll != 'activity_settings'
                   && coll != 'activity_tombstones';
    }

    // The canary's ENTIRE grant. A synthetic identity minted via
    // `admin.auth().createCustomToken(canaryUid, {canary: true})`
    // (server-side), exchanged for a real ID token via the Client SDK's
    // `signInWithCustomToken()` (never the Admin SDK, which would bypass
    // these rules and prove nothing about the real client path) can
    // read/write/delete ONLY its own `_canary/{that same uid}` document --
    // both the custom claim AND uid-equals-docId are required, so even a
    // second canary identity (if one is ever minted) could not reach the
    // first one's document. No other collection grants this claim anything;
    // see `isCanaryToken()`'s exclusion above for the one place that
    // matters most (it looks like ordinary per-user data).
    match /_canary/{canaryUid} {
      allow read, write, delete: if isCanaryToken()
                                  && request.auth.uid == canaryUid;
    }

    // F005: `abuse_guard.ts`'s daily quota lives at
    // `users/{uid}/usage/{yyyy-mm-dd}`, read-then-compare-then-write inside a
    // transaction so two concurrent calls cannot both slip under the limit.
    // The wildcard rule above used to let the same client that transaction
    // limits simply overwrite or delete its own counter directly — the
    // server-side atomicity bought nothing if the number it protected was
    // still client-writable. No client reads this collection today (the
    // callable returns whatever it needs in its own response), so closed
    // outright rather than opened read-only for a caller that does not exist.
    match /users/{uid}/usage/{day} {
      allow read, write: if false;
    }

    // F006: `generateAnnualReceipt` writes to `users/{uid}/receipts/{year}`
    // from figures it pulled from Stripe directly — no client-supplied
    // field reaches the document. The comment on that function is explicit
    // about why this collection cannot be client-writable: it is "the one
    // document a user might hand to a tax authority," and a client that can
    // edit or delete it after the fact makes it worthless as a record of
    // what was actually charged. No client reads this collection either
    // (the callable's own response is what the UI renders).
    match /users/{uid}/receipts/{year} {
      allow read, write: if false;
    }

    // N03: `DeviceHealthProfileRepository` (mobile/lib/features/profile/data/
    // device_health_profile_repository.dart) strips every free-text health
    // field out of a profile before `FirestoreProfileRepository` ever sees
    // it — that split is what backs the privacy policy's "health answers
    // stay on your phone" claim. It was enforced by client code alone:
    // nothing here independently rejected a write that skipped the strip,
    // whether from a modified client or a future regression in the decorator
    // itself. This mirrors the shape `stripSensitive()` produces
    // (sensitive_profile.dart) — every free-text/list health field empty,
    // and lifestyle.smoking/alcohol null — and rejects anything else, so a
    // write that still carries a real condition, medication or injury is
    // refused at the one layer a client cannot route around.
    // `screening` and `flags` are read through get() with a default, unlike the
    // eight fields above. Two different reasons, and both matter:
    //
    //   - tolerance: an older client that predates a field writes a `health`
    //     map without the key. A bare `h.flags` on a missing key errors, and an
    //     erroring rule denies -- which would reject a legitimate write from an
    //     installed build rather than the attack this is here to stop.
    //   - the defect this replaces: the function inspected eight fields and the
    //     model had grown to ten. `HealthHistory.toJson` serialises the PAR-Q+
    //     answers and the normalised flags INSIDE this same map, so a client
    //     that emptied the eight while carrying real screening answers and
    //     restrictions passed the check that exists to make the strip
    //     independent of the client. The most structured health data the model
    //     holds was the part the backstop did not look at.
    //
    // Same shape of miss as F014's (N-01): a field added to the model and its
    // serialiser, not added to the thing guarding it.
    // `hasOnly(...)` below is the guard against the exact defect this
    // function's own history is about: a field that reaches the wire under a
    // name none of the checks below inspect. Enumerating the values of ten
    // known keys says nothing about an eleventh one -- `hasOnly` is what
    // makes an unrecognised key (e.g. a compromised client sending
    // `health.privateDiagnosis`) fail the write instead of silently passing
    // because nothing asked about it. Kept in sync with `HealthHistory.toJson`
    // (mobile/lib/features/profile/data/profile_models.dart) -- a legitimate
    // field added there without being added here fails closed (the write is
    // refused), not open.
    function healthIsStripped(h) {
      return h.keys().hasOnly(['conditions', 'allergies', 'medications',
              'injuries', 'physicalLimitations', 'recentSurgeries',
              'bloodPressure', 'otherConcerns', 'screening', 'flags'])
          && h.conditions.size() == 0
          && h.allergies.size() == 0
          && h.medications.size() == 0
          && h.injuries.size() == 0
          && h.physicalLimitations.size() == 0
          && h.recentSurgeries.size() == 0
          && h.bloodPressure == null
          && h.otherConcerns == null
          && h.get('screening', {}).size() == 0
          && flagsAreStripped(h.get('flags', {}));
    }
    // Every answer HealthFlags can carry. Listed one by one rather than by
    // size(), because a stripped block legitimately still has the KEYS -- what
    // it must not have is a value in any of them. `hasOnly` closes the same
    // gap as `healthIsStripped` above, for the same reason -- kept in sync
    // with `HealthFlags.toJson` (mobile/lib/features/safety/data/health_flags.dart).
    //
    // Body Scan + Nutrition Coach (D-11, D-70): `nutritionGuidance` and
    // `foodAllergens` are health answers like the rest, so they join both the
    // key list and the "no value" list. The two new keys are checked
    // null-safely: a key that is present with a null value must not make
    // `.size()` error, and an erroring rule denies the whole profile save.
    // `HealthFlags.toJson` omits both keys while they are null/empty, so the
    // stripped form the server ever sees carries only the original five keys
    // and the deploy order of rules and client is not load-bearing.
    function flagsAreStripped(f) {
      return f.keys().hasOnly(['restrictions', 'bloodPressure', 'surgery',
              'clinicianAdvice', 'professionalGuidance',
              'nutritionGuidance', 'foodAllergens'])
          && f.get('restrictions', []).size() == 0
          && f.get('bloodPressure', null) == null
          && f.get('surgery', null) == null
          && f.get('clinicianAdvice', null) == null
          && f.get('professionalGuidance', null) == null
          && f.get('nutritionGuidance', null) == null
          && (f.get('foodAllergens', null) == null
              || f.get('foodAllergens', []).size() == 0);
    }
    // Shape check for the additive `nutrition` map on the profile document
    // (design s6.1d, D-68). Nothing in it is health data by construction:
    // allergens, the guidance answer and `excludedFoods` (free text that can
    // name an intolerance or a condition) are device-only, so `excludedFoods`
    // is deliberately NOT in the allowlist and a write carrying it is refused
    // (D-55). Every typed key is tolerant of an explicit null, because the
    // serializer may emit one and a type error here would refuse the whole
    // profile save. The ranges mirror the Dart clamps; this is a backstop.
    function nutritionOk(n) {
      return n is map
          && n.keys().hasOnly(['schema', 'sexAtBirth', 'goalDirection',
              'targetBodyFatPct', 'typicalDailySteps', 'mealsPerDay',
              'planOwnership', 'healthConnectChoice', 'completedAt'])
          && (n.get('sexAtBirth', null) == null
              || n.sexAtBirth in ['female', 'male', 'unspecified'])
          && (n.get('goalDirection', null) == null
              || n.goalDirection in ['lose', 'maintain', 'gain'])
          && (n.get('planOwnership', null) == null
              || n.planOwnership in ['coached', 'shared', 'manual'])
          && (n.get('mealsPerDay', null) == null
              || (n.mealsPerDay is int
                  && n.mealsPerDay >= 2 && n.mealsPerDay <= 6))
          && (n.get('targetBodyFatPct', null) == null
              || (n.targetBodyFatPct is number
                  && n.targetBodyFatPct >= 5 && n.targetBodyFatPct <= 60))
          && (n.get('typicalDailySteps', null) == null
              || (n.typicalDailySteps is int
                  && n.typicalDailySteps >= 0
                  && n.typicalDailySteps <= 100000));
    }
    match /users/{uid}/profile/{docId} {
      allow read: if isOrdinaryUser() && request.auth.uid == uid;
      // Tolerant of a write that omits `health`/`lifestyle` altogether
      // (a partial field update, or a document shape this rule has not seen
      // yet) — it only refuses a write that INCLUDES a health block and that
      // block is not the stripped shape. What it must never accept is a
      // present `health` carrying real content.
      allow write: if isOrdinaryUser()
                   && request.auth.uid == uid
                   && (!('health' in request.resource.data)
                       || healthIsStripped(request.resource.data.health))
                   && (!('nutrition' in request.resource.data)
                       || request.resource.data.nutrition == null
                       || nutritionOk(request.resource.data.nutrition))
                   && (!('lifestyle' in request.resource.data)
                       || (!('smoking' in request.resource.data.lifestyle)
                           || request.resource.data.lifestyle.smoking == null))
                   && (!('lifestyle' in request.resource.data)
                       || (!('alcohol' in request.resource.data.lifestyle)
                           || request.resource.data.lifestyle.alcohol == null));
    }

    // Equipment + exercise catalogs are read-only for clients.
    // Server-side admin scripts write these via the Admin SDK.
    match /equipment/{anyId} {
      allow read: if isOrdinaryUser();
      allow write: if false;
    }
    match /exercises/{anyId} {
      allow read: if isOrdinaryUser();
      allow write: if false;
    }

    // Gym registry — clients can read so the QR scanner can resolve
    // gymId → display name + maintenance metadata, but only the
    // server (Admin SDK) writes via the gym-onboarding tooling.
    match /gyms/{gymId} {
      allow read: if isOrdinaryUser();
      allow write: if false;
    }

    // Public donor wall — one document per donor who opted in.
    //
    // This block was missing, which meant the collection was default-denied
    // and `CloudDonorWallRepository` got permission-denied on every read for
    // every user. Its own comment says "public read, no client write"; the
    // read half was never granted. Broken at one user, not at a thousand.
    //
    // Read is open rather than `request.auth != null`: `/donors` is a public
    // route in the app router, reachable signed-out, and a wall of people who
    // chose to be listed publicly is the one collection here with nothing to
    // protect. Writes stay server-only — `optInDonorWall` verifies an active
    // subscription before adding anyone, and a client that could write here
    // could list itself as a donor without paying.
    //
    // Worth knowing when this goes live: it is the only shared-collection
    // listener in the app, so every opt-in fans out to every attached client.
    // The client keeps its `.limit(500)` for that reason.
    match /donor_wall/{donorId} {
      allow read: if true;
      allow write: if false;
    }

    // Equipment-failure reports (TX.7). Same server-only pattern as
    // subscriptions: the `reportEquipment` Cloud Function is the only
    // writer, and clients have no read access (reports surface to gym
    // staff via webhook + admin console, not the user's own app).
    match /equipment_reports/{anyId} {
      allow read: if false;
      allow write: if false;
    }

    // B6 session diagnostics. Written by DEBUG builds only, and read by
    // nobody through this API.
    //
    // Create-only for a signed-in user, and only for a document that stamps
    // its own uid. Not `allow write`, which would also grant update and
    // delete: a session log that a client can edit after the fact is not
    // evidence, it is a note. Read is closed outright -- these are inspected
    // in the Firebase console, and no client has any business reading another
    // person's session, or its own back.
    //
    // The log is redacted on the way in (core/diagnostics/debug_telemetry.dart)
    // and the collection only ever receives debug builds, but neither of those
    // is a rule. This is the rule.
    // P1a adds shape and size validation. Before it, this was the only
    // collection any signed-in client could write to in a shared namespace,
    // with no constraint but the uid stamp -- so a caller could create
    // unlimited documents of arbitrary shape, each up to Firestore's 1 MB
    // ceiling, under keys nothing reads. That is a storage bill with a uid
    // attached, and it is the same collection A3's export had to cap its
    // reads over for exactly this reason.
    //
    // The allowlist mirrors what `debug_telemetry.dart:175-179` and
    // `debug_telemetry_sink.dart:36-40` actually send, and the 500-event
    // ceiling is the writer's own ring-buffer capacity
    // (`debug_telemetry.dart:141`) rather than a number invented here -- so a
    // legitimate client cannot be refused, and a client sending more than its
    // own buffer can hold is not a legitimate client.
    //
    // This bounds SHAPE, not bytes: rules cannot measure document size, so a
    // 1 MB string inside `identity` still passes. What it removes is the
    // ability to store arbitrary keys and unbounded arrays, which is the part
    // that made this an open-ended dump.
    match /debug_sessions/{sessionId} {
      allow read: if false;
      allow create: if isOrdinaryUser()
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.keys().hasOnly(
                         ['identity', 'droppedCount', 'events',
                          'uid', 'receivedAt'])
                    && request.resource.data.keys().hasAll(['uid', 'events'])
                    && request.resource.data.events is list
                    && request.resource.data.events.size() <= 500;
      allow update, delete: if false;
    }

    // Coach marketplace bookings. This block grants nothing, and that is the
    // point of writing it down: the collection was previously absent from
    // this file entirely, so it was default-denied by accident of omission
    // rather than by decision. A reader could not tell the two apart, and the
    // next person to add a client-side booking query would have had no way to
    // know the denial was deliberate.
    //
    // `bookCoachSession` and `sweepSharedRecords` reach it with the Admin SDK,
    // which bypasses rules; `exportAccountData` reads a user's own bookings
    // the same way and redacts the counterparty. A client must never read
    // these directly: a booking names BOTH parties and carries a
    // payment-intent id (`index.ts:1154-1164`).
    match /coach_bookings/{bookingId} {
      allow read, write: if false;
    }

    // A coach's own marketplace listing, keyed by their uid. Same server-only
    // pattern as `coach_bookings` above -- and until this block, this
    // collection had NO rule of its own at all, so it was only default-denied
    // by Firestore's implicit deny-everything-unmatched behaviour rather than
    // by an explicit decision a reader could point at. Found while building
    // MVP1.G3-CI-8's data-lifecycle coverage guard, which surfaced it as a
    // real collection with no rules entry -- the same "present in code,
    // absent from the file that is supposed to name every collection" gap
    // `coach_bookings`'s own comment above already describes for itself.
    // `index.ts` reads/writes it via the Admin SDK (create/update the coach's
    // own listing, look up a coach by id) and `account_export.ts` exports a
    // user's own listing -- neither goes through client rules, so this stays
    // explicit-deny rather than opened for a client read that has no caller.
    match /coach_listings/{coachUid} {
      allow read, write: if false;
    }

    // Durable account-deletion retry records (index.ts `deleteAccount` /
    // `reconcileAccountDeletions`). One document per uid whose deletion is
    // not yet confirmed complete, written before the Auth user is deleted:
    // uid, status, retry bookkeeping and a bare error code, no user data.
    // Admin SDK only -- a client must never read, create, change or delete
    // one (it exists to outlive the Auth user, so no legitimate client caller
    // can exist).
    match /accountDeletionRetries/{uid} {
      allow read, write: if false;
    }

    // P1.G1 T2/T4 (SPTR Equipment Recognition v4.4, core/design/
    // sptr_equipment_recognition_v4_1/SPTR_EQUIPMENT_RECOGNITION_V4_4_GATE_
    // CONTRACTS_AND_AC_DOD_2026-08-22.md). A user's resolved exact-model
    // recognitions — server-written only (`functions-equipment-identity`'s
    // Admin SDK write path, once one exists), never client-authored. Owner
    // can read their own history; nobody can create/update/delete it from a
    // client, which is also how T4's authority-field immutability holds at
    // this layer: there is no client mutation surface at all, so a
    // `RecognitionAuthorityTuple` embedded in a resolved record can never be
    // altered post-write by anything but the server that wrote it.
    match /users/{uid}/recognised_models/{modelId} {
      allow read: if isOrdinaryUser() && request.auth.uid == uid;
      allow write: if false;
    }

    // In-flight identity resolution session state (P2.G3 introduces the
    // runtime that actually writes these; the collection is carved out of
    // client reach here, ahead of that gate, so no client build can ever
    // have depended on writing or reading it directly). Entirely
    // server-internal — no client read, no client write.
    match /users/{uid}/equipment_identity_sessions/{sessionId} {
      allow read, write: if false;
    }

    // Per-user pointer to whichever recognitionSessionId was pinned most
    // recently (P2.G3 pre-commit review round 2, 2026-09-11 -- cross-scan
    // supersession detection). Same server-only posture as the sessions
    // collection it points into.
    match /users/{uid}/equipment_identity_latest_session/{docId} {
      allow read, write: if false;
    }

    // Recognition telemetry (latency, outcome counts, model/version tags
    // used for shadow evaluation in P6). Written by the server pipeline
    // only; a client that could edit or delete its own telemetry would make
    // it worthless as an evaluation signal.
    match /users/{uid}/equipment_identity_telemetry/{docId} {
      allow read, write: if false;
    }

    // P1.G1 T2: top-level canonical-catalog authority collections. All
    // server/admin-only for the whole of P1 — no P1 app screen or Flutter
    // provider reads this catalog (see P1.G6 §11.14), so client access is
    // closed outright rather than opened read-only for a caller that does
    // not exist yet. `equipment_catalog_active/current` stays server-only
    // too until a real P2 client requirement earns it a narrower read grant
    // — see P1.G1 evidence doc for why that is deliberate, not an oversight.
    // Versioned entity docs use a `{catalogVersion}--{id}` composite docId
    // (see P1.G1 §5.15), so a single `{docId}` wildcard per collection
    // covers every version without a subcollection.
    match /equipment_brands/{docId} {
      allow read, write: if false;
    }
    match /equipment_product_lines/{docId} {
      allow read, write: if false;
    }
    match /equipment_models/{docId} {
      allow read, write: if false;
    }
    match /equipment_model_setup_specs/{docId} {
      allow read, write: if false;
    }
    match /equipment_external_mappings/{docId} {
      allow read, write: if false;
    }
    match /equipment_sources/{sourceId} {
      allow read, write: if false;
    }
    match /equipment_assets/{docId} {
      allow read, write: if false;
    }
    match /equipment_catalog_publish_jobs/{jobId} {
      allow read, write: if false;
    }
    match /equipment_catalog_versions/{catalogVersion} {
      allow read, write: if false;
    }
    match /equipment_catalog_active/{docId} {
      allow read, write: if false;
    }

    // P2.G3: derived lookup-key index (text_key_index.ts). Server/admin-only,
    // same reasoning as the catalog collections above -- it exists purely so
    // the equipmentIdentityResolveFromText Cloud Function can query it; no
    // client ever reads or writes it directly. Firestore already denies any
    // collection with no matching rule by default, so this block is not the
    // only thing preventing client access -- it exists so that fact is
    // explicit and greppable here, matching every other server-only
    // collection in this file rather than relying on the implicit default.
    match /equipment_model_text_keys/{docId} {
      allow read, write: if false;
    }

    // ---------------------------------------------------------------------
    // Body Scan + Nutrition Coach (design s6.1b, D-25). Every collection below
    // is carved out of the `users/{uid}/{coll}/{document=**}` wildcard in BOTH
    // its read and its write condition, so each block here is the ONLY grant
    // for its path. Every grant goes through `isOrdinaryUser()` so the canary
    // identity gets nothing (CR-05).
    //
    // These are the LAST line of defence against a forged or corrupted write,
    // not the policy: the profile-dependent safety clamps live in Dart. Rules
    // cannot measure document size and cannot loop, so list elements are
    // checked at fixed indexes only (see `listStringsOk`/`foodItemsOk`) and
    // the per-user caps on saved foods are client-side (stated limits).
    // ---------------------------------------------------------------------

    // Rules numeric helpers: `x is number` accepts both int and float.
    function numberIn(v, lo, hi) {
      return v is number && v >= lo && v <= hi;
    }
    function schemaOk(d) {
      return !('schema' in d) || d.schema is int;
    }

    // body_scans: SERVER-AUTHORED (D-7, D-52 cloud path only). The estimate,
    // provider, status and photo state can be neither forged nor erased by a
    // client, so create and delete are closed (the callables write with the
    // Admin SDK). The one client edit is `weightKg` / `clientNote`, judged on
    // `affectedKeys()` so an update that touches only `weightKg` on a document
    // that has no `clientNote` yet never errors on the missing key (D-68);
    // removing `clientNote` is allowed, removing `weightKg` is not.
    function bodyScanEditOk(n, o) {
      return n.diff(o).affectedKeys().hasOnly(['weightKg', 'clientNote'])
          && (!('weightKg' in n.diff(o).affectedKeys())
              || ('weightKg' in n && numberIn(n.weightKg, 30, 300)))
          && (!('clientNote' in n.diff(o).affectedKeys())
              || !('clientNote' in n)
              || (n.clientNote is string && n.clientNote.size() <= 200));
    }
    match /users/{uid}/body_scans/{scanId} {
      allow read: if isOrdinaryUser() && request.auth.uid == uid;
      allow create: if false;
      allow update: if isOrdinaryUser()
                    && request.auth.uid == uid
                    && bodyScanEditOk(request.resource.data, resource.data);
      allow delete: if false;
    }

    // body_scan_settings: one document, `main`. `cloudConsent` follows the
    // FIXED D-56 rule: valid when UNCHANGED (so a later retention / reminder /
    // paused write that merely carries the old consent passes), or when it is
    // new or bumped with `acceptedAt == request.time` and a version that does
    // not go down. Withdrawal (the key removed) is allowed and means "no
    // consent". A forged old timestamp, or a changed version carrying an old
    // timestamp, is refused.
    function priorConsentVersion(r) {
      return r == null ? 0 : r.data.get('cloudConsent', {}).get('version', 0);
    }
    function consentOk(n, r) {
      return !('cloudConsent' in n)
          || n.get('cloudConsent', null) == (r == null ? null : r.data.get('cloudConsent', null))
          || (n.cloudConsent is map
              && n.cloudConsent.keys().hasOnly(['version', 'acceptedAt'])
              && n.cloudConsent.keys().hasAll(['version', 'acceptedAt'])
              && n.cloudConsent.version is int
              && n.cloudConsent.version >= 1
              && n.cloudConsent.version >= priorConsentVersion(r)
              && n.cloudConsent.acceptedAt == request.time);
    }
    function reminderOk(m) {
      return m is map
          && m.keys().hasOnly(['enabled', 'weekday', 'minutes'])
          && (!('enabled' in m) || m.enabled is bool)
          && (!('weekday' in m) || (m.weekday is int && numberIn(m.weekday, 1, 7)))
          && (!('minutes' in m) || (m.minutes is int && numberIn(m.minutes, 0, 1439)));
    }
    function bodyScanSettingsOk(n, r) {
      return n.keys().hasOnly(['schema', 'cloudConsent', 'retentionDays',
              'reminder', 'paused'])
          && schemaOk(n)
          && consentOk(n, r)
          && (!('retentionDays' in n) || n.retentionDays in [0, 30, 90, 365])
          && (!('paused' in n) || n.paused is bool)
          && (!('reminder' in n) || reminderOk(n.reminder));
    }
    match /users/{uid}/body_scan_settings/{docId} {
      allow read: if isOrdinaryUser() && request.auth.uid == uid;
      allow create, update: if isOrdinaryUser()
                            && request.auth.uid == uid
                            && docId == 'main'
                            && bodyScanSettingsOk(request.resource.data, resource);
      allow delete: if isOrdinaryUser() && request.auth.uid == uid;
    }

    // weight_entries: day-keyed (`yyyy-MM-dd`), so a re-weigh the same day
    // overwrites. The trend maths uses `at`, not the key.
    function weightEntryOk(day, d) {
      return day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && d.keys().hasOnly(['schema', 'kg', 'at', 'source'])
          && d.keys().hasAll(['kg', 'at', 'source'])
          && schemaOk(d)
          && numberIn(d.kg, 30, 300)
          && d.at is timestamp
          && d.source in ['manual', 'scan'];
    }
    match /users/{uid}/weight_entries/{day} {
      allow read: if isOrdinaryUser() && request.auth.uid == uid;
      allow create, update: if isOrdinaryUser()
                            && request.auth.uid == uid
                            && weightEntryOk(day, request.resource.data);
      allow delete: if isOrdinaryUser() && request.auth.uid == uid;
    }

    // nutrition_plan: one document, `main`. `status` has no `referProfessional`
    // value (D-55: an ineligible verdict is computed on the device and never
    // persisted). `planVersion` is monotonic: an update must be exactly the
    // stored version + 1, which is what makes the weekly-review transaction's
    // `basePlanVersion` check meaningful across devices (D-57). The kcal floor
    // and ceiling are a HARD backstop only; the real, profile-dependent clamps
    // live in Dart (design s13).
    function gramsOk(v) {
      return v is int && v >= 0 && v <= 1000;
    }
    function macroBoundsOk(m, ks) {
      return m is map
          && m.keys().hasOnly(ks)
          && gramsOk(m.get('minG', 0))
          && gramsOk(m.get('targetG', 0))
          && gramsOk(m.get('maxG', 0));
    }
    function nutritionPlanOk(d) {
      return d.keys().hasOnly(['schema', 'status', 'planVersion', 'reviewUndo',
              'ownership', 'autoAdjust', 'goalDirection', 'ratePctPerWeek',
              'kcalRange', 'kcalBounds', 'protein', 'fat', 'carbs',
              'stepsGoal', 'inputsDigest', 'computedAt', 'lastKcalAdjustAt',
              'driftFromInitialKcal'])
          && d.keys().hasAll(['status', 'planVersion'])
          && schemaOk(d)
          && d.status in ['active', 'needsProfile']
          && d.planVersion is int
          && d.planVersion >= 1
          && (!('ownership' in d) || d.ownership in ['coached', 'shared', 'manual'])
          && (!('goalDirection' in d) || d.goalDirection in ['lose', 'maintain', 'gain'])
          && (!('ratePctPerWeek' in d) || d.ratePctPerWeek is number)
          && (!('driftFromInitialKcal' in d) || d.driftFromInitialKcal is int)
          && (!('stepsGoal' in d) || (d.stepsGoal is int && numberIn(d.stepsGoal, 2000, 30000)))
          && (!('kcalRange' in d)
              || (d.kcalRange is map
                  && d.kcalRange.keys().hasOnly(['low', 'high'])
                  && d.kcalRange.low is int
                  && d.kcalRange.high is int
                  && d.kcalRange.low >= 1200
                  && d.kcalRange.high <= 6000
                  && d.kcalRange.low <= d.kcalRange.high))
          && (!('kcalBounds' in d)
              || (d.kcalBounds is map
                  && d.kcalBounds.keys().hasOnly(['min', 'max'])))
          && (!('autoAdjust' in d)
              || (d.autoAdjust is map
                  && d.autoAdjust.keys().hasOnly(['steps', 'kcal'])))
          && (!('reviewUndo' in d)
              || (d.reviewUndo is map
                  && d.reviewUndo.keys().hasOnly(['week', 'prevKcalRange',
                      'prevStepsGoal', 'prevDrift', 'expiresAt', 'undone'])))
          && (!('inputsDigest' in d)
              || (d.inputsDigest is map && d.inputsDigest.keys().size() <= 12))
          && (!('protein' in d) || macroBoundsOk(d.protein, ['minG', 'targetG', 'maxG']))
          && (!('fat' in d) || macroBoundsOk(d.fat, ['minG', 'maxG']))
          && (!('carbs' in d) || macroBoundsOk(d.carbs, ['minG', 'maxG']));
    }
    match /users/{uid}/nutrition_plan/{docId} {
      allow read: if isOrdinaryUser() && request.auth.uid == uid;
      allow create: if isOrdinaryUser()
                    && request.auth.uid == uid
                    && docId == 'main'
                    && nutritionPlanOk(request.resource.data);
      allow update: if isOrdinaryUser()
                    && request.auth.uid == uid
                    && docId == 'main'
                    && nutritionPlanOk(request.resource.data)
                    && request.resource.data.planVersion == resource.data.planVersion + 1;
      allow delete: if isOrdinaryUser() && request.auth.uid == uid;
    }

    // nutrition_plan_reviews: keyed by ISO week, IMMUTABLE once written (the
    // "always explain why" history); written in one transaction together with
    // the plan change. `referProfessional` is not a valid decision (D-55).
    // List elements are checked at the first eight indexes, which is every
    // element a document with `size() <= 8` can have.
    function codeAt(l, i) {
      return l.size() <= i || (l[i] is string && l[i].size() <= 40);
    }
    function reviewOk(week, d) {
      return week.matches('^[0-9]{4}-W[0-9]{2}$')
          && d.keys().hasOnly(['schema', 'decidedAt', 'basePlanVersion',
              'decision', 'deltaKcal', 'deltaSteps', 'reasonCodes', 'inputs'])
          && d.keys().hasAll(['decision'])
          && schemaOk(d)
          && d.decision in ['keep', 'adjustKcal', 'adjustSteps',
              'needMoreData', 'needRecalculation']
          && (!('basePlanVersion' in d) || d.basePlanVersion is int)
          && (!('deltaKcal' in d) || d.deltaKcal is int)
          && (!('deltaSteps' in d) || d.deltaSteps is int)
          && (!('inputs' in d) || d.inputs is map)
          && (!('reasonCodes' in d)
              || (d.reasonCodes is list
                  && d.reasonCodes.size() <= 8
                  && codeAt(d.reasonCodes, 0) && codeAt(d.reasonCodes, 1)
                  && codeAt(d.reasonCodes, 2) && codeAt(d.reasonCodes, 3)
                  && codeAt(d.reasonCodes, 4) && codeAt(d.reasonCodes, 5)
                  && codeAt(d.reasonCodes, 6) && codeAt(d.reasonCodes, 7)));
    }
    match /users/{uid}/nutrition_plan_reviews/{week} {
      allow read: if isOrdinaryUser() && request.auth.uid == uid;
      allow create: if isOrdinaryUser()
                    && request.auth.uid == uid
                    && reviewOk(week, request.resource.data);
      allow update: if false;
      allow delete: if isOrdinaryUser() && request.auth.uid == uid;
    }

    // food_entries and saved_foods (D-68). `items` is checked per element at
    // fixed indexes in groups of ten, deliberately CHEAP (element is a map with
    // a string `name` <= 80): a full numeric check of every field of 30 items
    // would exceed the per-request expression budget and refuse legitimate
    // large entries. The numeric ranges are enforced on `totals` (and on
    // `per100g` for saved foods); the server recomputes macros from
    // `per100g x grams` for AI-assisted entries. Bounds the SHAPE, not the
    // bytes (rules cannot measure document size).
    // Per-element check, INLINED for all 30 slots. Firestore Rules allow 1000
    // expression evaluations per request, and the function-call form
    // (`foodItemAt(l, s + k)`) exceeded that budget for EVERY entry, even a
    // one-item one, which made `food_entries` unwritable (found by the E0 rules
    // test). Inlined, a 30-item entry with every optional field fits (measured
    // on the emulator). A non-map element, or one without a string-like
    // `name`, makes `.name.size()` ERROR, and an erroring rule refuses the
    // write, the same outcome as an explicit type check at a fraction of the cost.
    function foodItemsAll(l) {
      return (l.size() <= 0 || l[0].name.size() <= 80)
          && (l.size() <= 1 || l[1].name.size() <= 80)
          && (l.size() <= 2 || l[2].name.size() <= 80)
          && (l.size() <= 3 || l[3].name.size() <= 80)
          && (l.size() <= 4 || l[4].name.size() <= 80)
          && (l.size() <= 5 || l[5].name.size() <= 80)
          && (l.size() <= 6 || l[6].name.size() <= 80)
          && (l.size() <= 7 || l[7].name.size() <= 80)
          && (l.size() <= 8 || l[8].name.size() <= 80)
          && (l.size() <= 9 || l[9].name.size() <= 80)
          && (l.size() <= 10 || l[10].name.size() <= 80)
          && (l.size() <= 11 || l[11].name.size() <= 80)
          && (l.size() <= 12 || l[12].name.size() <= 80)
          && (l.size() <= 13 || l[13].name.size() <= 80)
          && (l.size() <= 14 || l[14].name.size() <= 80)
          && (l.size() <= 15 || l[15].name.size() <= 80)
          && (l.size() <= 16 || l[16].name.size() <= 80)
          && (l.size() <= 17 || l[17].name.size() <= 80)
          && (l.size() <= 18 || l[18].name.size() <= 80)
          && (l.size() <= 19 || l[19].name.size() <= 80)
          && (l.size() <= 20 || l[20].name.size() <= 80)
          && (l.size() <= 21 || l[21].name.size() <= 80)
          && (l.size() <= 22 || l[22].name.size() <= 80)
          && (l.size() <= 23 || l[23].name.size() <= 80)
          && (l.size() <= 24 || l[24].name.size() <= 80)
          && (l.size() <= 25 || l[25].name.size() <= 80)
          && (l.size() <= 26 || l[26].name.size() <= 80)
          && (l.size() <= 27 || l[27].name.size() <= 80)
          && (l.size() <= 28 || l[28].name.size() <= 80)
          && (l.size() <= 29 || l[29].name.size() <= 80);
    }
    // `low <= mid <= high` plus `0 <= low` and `high <= 100000` bounds every
    // value in one comparison chain (a missing or non-numeric key errors, which
    // refuses the write). The earlier per-value `numberIn(r.get(...))` form cost
    // about four times as many expressions.
    function rangeOk(r) {
      return r is map
          && r.keys().hasOnly(['low', 'mid', 'high'])
          && r.low >= 0 && r.low <= r.mid && r.mid <= r.high && r.high <= 100000;
    }
    function totalsOk(t) {
      return t is map
          && t.keys().hasOnly(['kcal', 'proteinG', 'carbsG', 'fatG'])
          && t.keys().hasAll(['kcal', 'proteinG', 'carbsG', 'fatG'])
          && rangeOk(t.kcal)
          && rangeOk(t.proteinG)
          && rangeOk(t.carbsG)
          && rangeOk(t.fatG);
    }
    function foodEntryOk(d) {
      return d.keys().hasOnly(['schema', 'day', 'slot', 'loggedAt', 'name',
              'source', 'confidence', 'items', 'totals', 'checkThese', 'model'])
          && d.keys().hasAll(['day', 'slot', 'loggedAt', 'name', 'source',
              'items', 'totals'])
          && schemaOk(d)
          && d.day is string
          && d.day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && d.slot in ['breakfast', 'lunch', 'dinner', 'snack']
          && d.source in ['photo', 'describe', 'search', 'barcode', 'label', 'manual']
          && (!('confidence' in d) || d.confidence in ['low', 'medium', 'high'])
          && d.loggedAt is timestamp
          && d.name is string
          && d.name.size() <= 80
          && d.items is list
          && d.items.size() >= 1
          && d.items.size() <= 30
          && foodItemsAll(d.items)
          && (!('checkThese' in d)
              || (d.checkThese is list && d.checkThese.size() <= 8))
          && (!('model' in d) || d.model is map)
          && totalsOk(d.totals);
    }
    match /users/{uid}/food_entries/{entryId} {
      allow read: if isOrdinaryUser() && request.auth.uid == uid;
      allow create, update: if isOrdinaryUser()
                            && request.auth.uid == uid
                            && foodEntryOk(request.resource.data);
      allow delete: if isOrdinaryUser() && request.auth.uid == uid;
    }

    function per100gOk(p) {
      return p is map
          && p.keys().hasOnly(['kcal', 'proteinG', 'carbsG', 'fatG'])
          && numberIn(p.get('kcal', 0), 0, 1000)
          && numberIn(p.get('proteinG', 0), 0, 1000)
          && numberIn(p.get('carbsG', 0), 0, 1000)
          && numberIn(p.get('fatG', 0), 0, 1000);
    }
    function savedFoodOk(d) {
      return d.keys().hasOnly(['schema', 'name', 'per100g', 'servingG',
              'barcode', 'createdAt'])
          && d.keys().hasAll(['name', 'per100g'])
          && schemaOk(d)
          && d.name is string
          && d.name.size() <= 80
          && per100gOk(d.per100g)
          && (!('servingG' in d) || numberIn(d.servingG, 0, 100000))
          && (!('barcode' in d) || (d.barcode is string && d.barcode.size() <= 32))
          && (!('createdAt' in d) || d.createdAt is timestamp);
    }
    match /users/{uid}/saved_foods/{foodId} {
      allow read: if isOrdinaryUser() && request.auth.uid == uid;
      allow create, update: if isOrdinaryUser()
                            && request.auth.uid == uid
                            && savedFoodOk(request.resource.data);
      allow delete: if isOrdinaryUser() && request.auth.uid == uid;
    }

    // Top-level, NOT user data, Admin SDK only. `nutrition_cache` holds the
    // central cache of public nutrition-database responses AND the upstream
    // budget counters (`budget_off_*`, D-64); `body_scan_purge_state` holds
    // only purge bookkeeping: the unmatched-object sweep's listing page token
    // (D-59), the per-operation delete fences and transient late_sweep_<hash>
    // records. `nutrition_cache` carries no uid. In `body_scan_purge_state`
    // only a late_sweep record carries a uid, for about 17 minutes under
    // normal operation (retried every 5 minutes, no hard bound) until the
    // late-upload sweep deletes it; server-only.
    match /nutrition_cache/{key} {
      allow read, write: if false;
    }
    match /body_scan_purge_state/{id} {
      allow read, write: if false;
    }
  }
}
