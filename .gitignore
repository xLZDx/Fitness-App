mobile/ios/Runner/GoogleService-Info.plist
.firebase/
firebase-debug.log
# `firebase_options.dart` IS committed — it's regenerated by flutterfire
# configure but contains no secrets that aren't already in the per-platform
# config files (which are what carries the actual keys).

