mobile/android/key.properties*
mobile/android/app/release/
mobile/android/app/debug/
mobile/android/.idea/
mobile/android/*.iml
mobile/android/.cxx/

# macOS / Linux junk
*.log

# Per-developer Firebase secrets (never commit)
mobile/android/app/google-services.json
# ...including the copies taken before replacing it. The file is not in git,
# so there is no history to restore from and a backup is the only way back --
# which is exactly why one must not be committed by accident either.
mobile/android/app/google-services.json.bak-*
mobile/ios/Runner/GoogleService-Info.plist
.firebase/
firebase-debug.log
firestore-debug.log
# Personal-machine workaround for a local port conflict (Docker Desktop
# holding 8080) when running functions-equipment-identity's e2e suite --
# see FIREBASE_EMULATOR_CONFIG in that package's jest.e2e.setup.js. Not a
# repo convention; never committed.
/firebase.e2e-equipment-identity.json
# `firebase_options.dart` IS committed — it's regenerated by flutterfire
# configure but contains no secrets that aren't already in the per-platform
# config files (which are what carries the actual keys).

# Generated code
*.g.dart
*.freezed.dart
*.gr.dart
*.mocks.dart

# Stray editor artefacts
* - Copy.md

# Generated by `flutter test --coverage`. A build artifact, not source.
mobile/coverage/

# Operator gym photos saved as a future training dataset for equipment_v2
# (raw JPEGs, ~100 MB — never commit)
data/gym_photos_*/

# Ad-hoc copy of the same real gym photos made before the data/gym_photos_*/
# convention above was (re)discovered during the 2026-09-17 recognition-accuracy
# eval — contains privacy-sensitive photos (trainer portraits, a minor) that must
# never reach git history. Left in place rather than deleted (shell policy blocks
# recursive delete without separate confirmation); this entry is the guard against
# accidentally staging it.
core/ml/eval/holdout_gym_photos_2026/

# Python bytecode from the catalog build scripts.
__pycache__/
*.pyc

# F0.6 — App Check debug token, passed via --dart-define at run time.
# Never committed: it is the secret that lets a build bypass Play Integrity.
.env
.env.*
!.env.example
