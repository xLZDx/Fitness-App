# Build artefacts and editor metadata
.idea/
.vscode/
*.iml
*.swp
.DS_Store

# Debug-daemon captures (logs/sessions/<timestamp>/...). Each session
# easily runs to a few hundred MB of screencaps + logcat — never commit.
logs/

# Recordings, screenshots, generated images (keep checked-in only what we curate)
*.mp4
*.mov
# Exception: the two curated reference clips inside the full design handoff
# archive are small (< 3MB each), deliberately kept, and referenced by the
# handoff's own Form Coach spec -- see README_LOCAL.md in that directory.
!core/design/reference/full_handoff_v1/uploads/*.mp4
docs/rec_frames/
docs/v3_*.png
docs/01_*.png
docs/02_*.png
docs/03_*.png
docs/04_*.png
docs/05_*.png
docs/06_*.png
docs/at_login.png
docs/home_*.png
docs/train_*.png
docs/login_*.png
docs/app_screenshot.png
docs/reference_full.png

# Flutter / Dart
mobile/.dart_tool/
mobile/.flutter-plugins
mobile/.flutter-plugins-dependencies
mobile/.packages
mobile/build/
mobile/.pub-cache/
mobile/.pub/
mobile/pubspec.lock
mobile/ios/Pods/
mobile/ios/Flutter/Generated.xcconfig
mobile/ios/Runner/GeneratedPluginRegistrant.*

# Android
mobile/android/.gradle/
mobile/android/captures/
mobile/android/local.properties
mobile/android/key.properties*
mobile/android/app/release/
mobile/android/app/debug/
mobile/android/.idea/
mobile/android/*.iml
mobile/android/.cxx/

# macOS / Linux junk
*.log

# Per-developer Firebase secrets (never commit)
mobile/android/app/google-services.json
# ...including the copies taken before replacing it. The file is not in git,
# so there is no history to restore from and a backup is the only way back --
# which is exactly why one must not be committed by accident either.
mobile/android/app/google-services.json.bak-*
mobile/ios/Runner/GoogleService-Info.plist
.firebase/
firebase-debug.log
# `firebase_options.dart` IS committed — it's regenerated by flutterfire
# configure but contains no secrets that aren't already in the per-platform
# config files (which are what carries the actual keys).

# Generated code
*.g.dart
*.freezed.dart
*.gr.dart
*.mocks.dart

# Stray editor artefacts
* - Copy.md

# Generated by `flutter test --coverage`. A build artifact, not source.
mobile/coverage/

# Operator gym photos saved as a future training dataset for equipment_v2
# (raw JPEGs, ~100 MB — never commit)
data/gym_photos_*/

# Python bytecode from the catalog build scripts.
__pycache__/
*.pyc

# F0.6 — App Check debug token, passed via --dart-define at run time.
# Never committed: it is the secret that lets a build bypass Play Integrity.
.env
.env.*
!.env.example
