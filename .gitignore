# Build artefacts and editor metadata
.idea/
.vscode/
*.iml
*.swp
.DS_Store

# Debug-daemon captures (logs/sessions/<timestamp>/...). Each session
# easily runs to a few hundred MB of screencaps + logcat — never commit.
logs/

# Recordings, screenshots, generated images (keep checked-in only what we curate)
*.mp4
*.mov
# Exception: the two curated reference clips inside the full design handoff
# archive are small (< 3MB each), deliberately kept, and referenced by the
# handoff's own Form Coach spec -- see README_LOCAL.md in that directory.
!core/design/reference/full_handoff_v1/uploads/*.mp4
# Same exception for the current canonical design export (supersedes
# full_handoff_v1 for Form Coach) -- see MEMORY project-fitness-app-design-
# reference-canonical-source.md for why this must not go stale again.
!core/design/reference/fitness_hud_v1/uploads/*.mp4
# And for the bundled Form Coach demonstration clips derived from that
# reference (G17, 2026-09-04): shipped in the app, declared in pubspec, so a
# checkout without them builds a demonstration that fails soft to its poster.
!mobile/assets/coach_demo/*.mp4
docs/rec_frames/
docs/v3_*.png
docs/01_*.png
docs/02_*.png
docs/03_*.png
docs/04_*.png
docs/05_*.png
docs/06_*.png
docs/at_login.png
docs/home_*.png
docs/train_*.png
docs/login_*.png
docs/app_screenshot.png
docs/reference_full.png

