rules_version = '2';

// Cloud Storage rules.
//
// The exercise video library is world-readable and nobody-writable.
//
// READABLE because it is demonstration footage attached to a public catalog,
// fetched by a video player on a phone. The alternative — requiring an auth
// token — means every clip carries the app's credentials to a CDN edge, and
// buys nothing: the catalog that lists the urls ships inside the APK, so the
// paths are not secret and pretending otherwise would be theatre.
//
// WRITABLE BY NOBODY from the client. The library is uploaded by an operator
// with project credentials, not by the app. A bucket that accepts client
// writes is a free file host for whoever decompiles the APK, and it is the
// single most common way a Firebase project turns into someone else's storage
// bill.
service firebase.storage {
  match /b/{bucket}/o {
    match /exercises/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }

    // Everything else is closed. Explicit rather than implied: a later feature
    // that needs a path here has to say so, instead of inheriting a rule
    // written for videos.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
