rules_version = '2';

// Deny-all for the DEFAULT Firebase Storage bucket (design s6.3, D-16).
//
// There was no `storage.rules` and `firebase.json` had no `storage` block, so
// whatever rules were deployed to the default bucket were unknown. The app does
// not use the `firebase_storage` plugin (VERIFIED absent in mobile/pubspec.yaml)
// and no client has any business reaching this bucket through the Storage SDK.
//
// The Body Scan photos live in a SEPARATE private bucket
// (`<project>-bodyscan-private`, runbooks/body_scan_bucket.md) that Firebase
// rules do not govern at all: it is reachable only through V4 signed URLs
// minted by the callables and through the Admin SDK, with public access
// prevention enforced. Admin SDK access bypasses these rules, so this file
// cannot break the server paths.
//
// Deploying this file OVERWRITES whatever is currently deployed for the default
// bucket; verify nothing public depends on it first (runbook note).
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
