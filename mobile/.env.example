# F0.6 — App Check debug token for local development.
#
# Copy to `mobile/.env` and fill in the real value. `.env` is gitignored;
# this example is not, and must never hold the real token.
#
# What it is: the secret that lets a locally-built debug APK pass App Check
# without Play Integrity attestation. A `flutter run` debug build is neither
# Play- nor App-Distribution-signed, so it cannot pass Play Integrity under
# any App Check console config (this is a build-signing gap, not the
# distribution-channel one -- see `functions/src/scaling.ts:91-107` for the
# outside-Play/App-Distribution correction, which does NOT apply to raw
# local debug builds). Once enforcement is on, a debug build without this
# token is refused exactly like an attacker would be.
#
# Where the real one lives: registered in Firebase Console under
# App Check -> Apps -> fitness_app (android) -> Manage debug tokens,
# display name "local dev (F0.6, created via API)".
#
# How it is used (the value is never compiled into a committed file):
#   flutter run --dart-define=APP_CHECK_DEBUG_TOKEN=<value>
#
# Release builds ignore this entirely — `kDebugMode` is compiled out of
# them, so the debug provider branch in main.dart does not exist there.

APP_CHECK_DEBUG_TOKEN=REPLACE_WITH_THE_TOKEN_FROM_FIREBASE_CONSOLE
