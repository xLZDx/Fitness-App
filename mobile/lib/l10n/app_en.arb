  "formcheckGateUnitMismatch": "Something is wrong on our side - the camera is reporting positions this app cannot read. Counting and form checks have paused.",
  "@formcheckGateUnitMismatch": {
    "description": "Shown when landmark coordinates arrive outside the documented range. Two constraints, both learned the hard way. It must not ask the user to move: no amount of stepping back changes a coordinate the app failed to convert. And it must not promise that rep counting continues - RepSessionController drops every unscorable frame before the counter sees it, so the count freezes. An earlier version of this string promised exactly that and was false in both languages."
  },
  "formcheckUpgradeSubtitle": "Works on the phone you already own - no depth camera, no extra hardware.",
  "formcheckVoiceUnavailable": "Voice coaching is unavailable on this device - the steps below still work.",
  "formcheckWaitingForTop": "stand tall to start counting",
  "@formcheckWaitingForTop": {
    "description": "Shown under the rep count while the counter has not yet seen the lifter standing at the top. Until it does, the count physically cannot move, and a frozen zero with no explanation reads as a broken app."
  },
  "formcheckRepNotCounted": "That attempt did not count - the movement came back short.",
  "@formcheckRepNotCounted": {
    "description": "A lap the counter discarded as incomplete. Deliberately says the attempt was not counted rather than telling the user to go deeper: the counter measures hip height against knee height, which depends on where the phone is standing, and an earlier cue built on that quantity told the operator to sink lower at the bottom of a full squat."
  },
  "formcheckRepNotCountedTooFast": "That attempt did not count - too fast to be a rep.",
  "@formcheckRepNotCountedTooFast": {
    "description": "A lap completed faster than a body can move, which is usually a tracking glitch rather than the user rushing. Stated as a fact about the count, not as a correction."
  },
