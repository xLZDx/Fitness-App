<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ (`android:dataExtractionRules`). The pre-12 twin is
  `backup_rules.xml`; see that file for why progress photos are excluded and
  why the path is `app_flutter/progress_photos` rather than anything under
  `domain="file"`.

  Two sections, and both are needed. `cloud-backup` is the Google Drive path
  the consent copy is about. `device-transfer` is the phone-to-phone copy, and
  leaving it out would keep the promise on one route while breaking it on the
  other: the photos would arrive on the new device as envelopes whose key
  never left the old phone's Keystore - undecryptable files the user cannot
  delete from a screen that will not list them, which is worse than not
  transferring them at all.

  `app_flutter/scan_history` (the on-phone scan history: scanned machine photos,
  raw model answers, ratings) is excluded from both sections for the same
  reason: private to the phone, handed over only by the user's own export.

  The same two sections also exclude the sensitive preference files (privacy
  decision B): `FlutterSharedPreferences.xml` (plaintext health/injury profile,
  training-context answer) and the `flutter_secure_storage` files
  `FlutterSecureStorage.xml` / `FlutterSecureKeyStorage.xml`. See
  `backup_rules.xml` for the reasoning and the consequence on restore.

  The activity journal directories (`activity_journal`, the production
  per-account tree, plus the legacy `journal`, `sources`, `quarantine`, all under
  `domain="file"`, S02-02 / GPS-PRIV-083) are excluded in BOTH sections for the
  same reason: cloud backup and device transfer must not carry routes.

  The S04 GPS recording journal (`activity_journal/<scopeId>/recording/`) is
  covered by the `activity_journal` lines in both sections; see
  `backup_rules.xml` (S04-15).
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="app_flutter/progress_photos" />
        <exclude domain="root" path="app_flutter/scan_history" />
        <exclude domain="sharedpref" path="FlutterSharedPreferences.xml" />
        <exclude domain="sharedpref" path="FlutterSecureStorage.xml" />
        <exclude domain="sharedpref" path="FlutterSecureKeyStorage.xml" />
        <exclude domain="file" path="journal" />
        <exclude domain="file" path="sources" />
        <exclude domain="file" path="quarantine" />
        <exclude domain="file" path="activity_journal" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="app_flutter/progress_photos" />
        <exclude domain="root" path="app_flutter/scan_history" />
        <exclude domain="sharedpref" path="FlutterSharedPreferences.xml" />
        <exclude domain="sharedpref" path="FlutterSecureStorage.xml" />
        <exclude domain="sharedpref" path="FlutterSecureKeyStorage.xml" />
        <exclude domain="file" path="journal" />
        <exclude domain="file" path="sources" />
        <exclude domain="file" path="quarantine" />
        <exclude domain="file" path="activity_journal" />
    </device-transfer>
</data-extraction-rules>
