# Imported audit evidence is stored byte-for-byte and its SHA-256 hashes are
# recorded in the MANIFEST.csv beside it. This repository is developed with
# core.autocrlf enabled, which rewrites line endings on checkout -- four of the
# imported artifacts are LF-only, so without this rule a fresh clone would hand
# back different bytes and every hash in the manifest would fail to verify.
#
# The point of importing originals is that a later reader can prove the bytes
# were not edited. Marking them -text is what makes that true on Windows too.
# Verified by tools/evidence/validate_csv_evidence.py.
core/audit/** -text

# P0.G4's type_snapshot.py hashes mobile/assets/data/equipment.json's raw
# bytes as sourceSha256 (canonical_json.file_sha256). Without a pinned eol,
# core.autocrlf=true (this repo's setting) checks this file out as CRLF on
# Windows and LF on a default Linux CI runner -- same content, two
# different hashes, which would fail test_generated_files_on_disk_match_a_
# fresh_build in CI for a reason that has nothing to do with the snapshot
# actually being stale. Pinning eol=lf makes every checkout produce the
# same bytes regardless of platform. Flagged in P0.G4's review round.
mobile/assets/data/equipment.json text eol=lf
core/equipment_identity/p0/*.json text eol=lf

# RECOG-C1's measurement artifacts are identified by hash, and the freeze
# manifest (core/plans/RECOG_C1_FREEZE_MANIFEST.json) records the hash of the
# NEWLINE-NORMALISED bytes precisely because these files were not pinned: with
# core.autocrlf on, the run plan sits in the working tree as CRLF while the
# generator wrote LF, so the raw hash differs from the recorded one on this
# machine and would differ again, differently, on a Linux CI runner.
#
# Normalising at every comparison site works but has to be remembered at every
# comparison site, and the JSONL the device writes is LF regardless of what any
# checkout thinks. Pinning -text makes raw bytes == normalised bytes on every
# platform, so the manifest's hash is verifiable directly and a fresh clone
# cannot produce a different file than the one that was frozen.
# Narrowed to the artifacts the freeze manifest actually identifies by hash,
# plus the raw output. A wildcard over RECOG_C1_*.csv also caught the arm
# manifest, the label sheet and the contact-sheet manifest -- none of which is
# hash-tracked, and all of which would then have shown as "Binary files differ"
# in review, since -text governs diffing as well as checkout. Losing a row-level
# diff on three files, in a repo whose whole review discipline is reading
# diffs, buys nothing here.
core/plans/RECOG_C1_RUN_PLAN_2026-09-05.csv -text
core/plans/RECOG_C1_GROUND_TRUTH_2026-09-05.csv -text
core/plans/recog_c1_raw/*.jsonl -text

# Gate C seals the expected poseTargetId change as a SHA-256 over this file's
# exact bytes, recorded in the approved plan before the rule that produces the
# change was written. core.autocrlf=true would hand a fresh Windows checkout
# CRLF and the digest would fail to verify -- destroying the only thing the
# seal exists to prove. Same reason as the rules above.
core/pose_targets/GATE_C_EXPECTED_TRANSITIONS.tsv text eol=lf

# RECOG-SO1 seals twelve artefacts by SHA-256 over their exact bytes, recorded
# in RECOG_SO1_PREREGISTRATION_2026-09-07.md before any Qwen output existed, and
# the runner re-hashes every one of them at start-up and REFUSES to transmit if
# one has changed. Under core.autocrlf=true a fresh Windows checkout would hand
# back CRLF, every digest would miss, and the seal would refuse forever -- fail-
# safe, but it would make the experiment unrunnable by anyone who cloned the
# repository, which destroys the reproducibility the seal exists to provide.
# Same reason as the Gate C line above.
core/plans/RECOG_SO1_OBSERVATION_MANIFEST_2026-09-07.csv text eol=lf
core/plans/RECOG_SO1_PEOPLE_SURVEY_2026-09-07.csv text eol=lf
core/plans/RECOG_SO1_CONSENT.schema.json text eol=lf
core/plans/RECOG_SO1_PREREGISTRATION_2026-09-07.md text eol=lf
scripts/dev/recog_so1_prompt.txt text eol=lf
scripts/dev/recog_so1_vocab.json text eol=lf
scripts/dev/recog_so1_config.json text eol=lf
scripts/dev/recog_so1_build_vocab.py text eol=lf
scripts/dev/recog_so1_build_prompt.py text eol=lf
scripts/dev/recog_so1_build_manifest.py text eol=lf
scripts/dev/recog_so1_run.py text eol=lf
scripts/dev/recog_so1_score.py text eol=lf
scripts/dev/recog_so1.tests.py text eol=lf

# SO1 run #1 is preserved as an audit artefact of an INVALID instrument run:
# 46 answered, 58 quota failures, deliberately never scored. Same reasoning as
# the recog_c1_raw line above -- an evidence file that a later reader may want
# to hash must not depend on which platform checked it out.
core/plans/recog_so1_raw/*.jsonl -text

# RECOG-SO1 REVISION 2. Same reasoning as the revision 1 block above, and git
# said so itself when these files were first staged: "LF will be replaced by
# CRLF the next time Git touches it". With core.autocrlf=true and no pin, the
# next checkout would hand back different bytes and every digest in the
# revision 2 seal would fail -- on this machine, not only on a Linux runner.
# RECOG_C1_GROUND_TRUTH is pinned here rather than in the revision 1 block
# because revision 2 is the first protocol to seal it: the partition algorithm
# reads the ground truth, so the allocation depends on its exact bytes.
core/plans/RECOG_C1_GROUND_TRUTH_2026-09-05.csv text eol=lf
core/plans/RECOG_SO1_PARTITION_1_R2_2026-09-08.csv text eol=lf
